extends SceneTree
## Writes docs/playthroughs.md: the record of the three simulated players (bots, not people).
##   godot --headless --path . --script res://tools/playthroughs.gd [-- --seed=1147]
## Autoloads only exist once the tree runs, so the harness is loaded at runtime, not by name.

const OUT := "res://docs/playthroughs.md"


func _initialize() -> void:
	await process_frame
	var seed_value := 1147
	for arg in OS.get_cmdline_user_args():
		if arg.begins_with("--seed="):
			seed_value = int(arg.trim_prefix("--seed="))
	var harness: GDScript = load("res://tests/sim/playthrough.gd")
	var md := PackedStringArray([
		"# Simulated playthroughs",
		"",
		"Generated by `tools/playthroughs.gd` (seed %d, Godot %s). These are **rule-based bots driving the simulation core**, not human playtests: they walk straight lines at 2.2 m/s, know where every object is, read text instantly and never hesitate, so their times are a lower bound on how long people take. No human playtest has been run yet." % [seed_value, Engine.get_version_info()["string"]],
		"",
		"| Bot | Plays like | Ending | Sim time | Events | Director picks | Signs | Errors | Warnings | Entity violations | Worst director eval |",
		"|---|---|---|---|---|---|---|---|---|---|---|",
	])
	var runs: Array[Dictionary] = []
	var styles := {
		"explorer": "investigates every sound, reads everything, lights every room, knocks back",
		"avoider": "moves away from sounds, keeps to lit rooms, follows an objective only after 45 s, takes the lift",
		"passive": "waits; one step towards the objective a minute; never makes the final choice",
	}
	for profile: String in ["explorer", "avoider", "passive"]:
		var r: Dictionary = harness.run(profile, seed_value)
		runs.append(r)
		md.append("| %s | %s | %s | %s | %d | %d | %d | %d | %d | %d | %d µs |" % [profile, styles[profile], r["ending"] if r["ending"] != &"" else "**none**", _mmss(r["time"]), r["events"].size(), r["decisions"].size(), r["signs"], r["errors"].size(), r["warnings"].size(), r["violations"].size(), r["max_eval_usec"]])
	md.append("")
	md.append("Worst director eval is the slowest single evaluation in the run (a maximum, not an average).")
	for r in runs:
		md.append_array(_section(r))
	var f := FileAccess.open(OUT, FileAccess.WRITE)
	f.store_string("\n".join(md) + "\n")
	f.close()
	print("wrote ", ProjectSettings.globalize_path(OUT))
	quit()


func _section(r: Dictionary) -> PackedStringArray:
	var out := PackedStringArray(["", "## %s" % r["profile"], "", "### Progression", "", "| Time | Act | Beat | Signs |", "|---|---|---|---|"])
	for g: Dictionary in r["progress"]:
		out.append("| %s | %d | %s | %d |" % [_mmss(g["t"]), g["act"], g["beat"], g["signs"]])
	out.append_array(["", "Clues found: %s" % (", ".join(r["clues"].map(func(c: StringName) -> String: return String(c))) if not r["clues"].is_empty() else "none")])
	out.append_array(["", "### Event sequence (%d)" % r["events"].size(), "", "| Time | Event | Room | Result | Source |", "|---|---|---|---|---|"])
	for e: Dictionary in r["events"]:
		out.append("| %s | %s | %s | %s | %s |" % [_mmss(e["t"]), e["id"], e["room"], e["result"], "director" if e["priority"] == 0 else "story (priority %d)" % e["priority"]])
	out.append_array(["", "### Director decisions (%d)" % r["decisions"].size(), "", "Top three candidates at each pick; total = base + behaviour + narrative + tension + repetition.", "", "| Time | Act | Tension | Chosen | Candidates |", "|---|---|---|---|---|"])
	for d: Dictionary in r["decisions"]:
		var cands: Array = d["scores"].map(func(s: Dictionary) -> String:
			var p: Dictionary = s["parts"]
			return "%s %.2f (%.2f/%.2f/%.2f/%.2f/%.2f)" % [s["id"], s["total"], p["base"], p["behavior"], p["narrative"], p["tension"], p["repetition"]])
		out.append("| %s | %d | %.2f | %s | %s |" % [_mmss(d["t"]), d["act"], d["tension"], d["chosen"], "; ".join(cands)])
	var b: Dictionary = r["behavior"]
	var signals := PackedStringArray()
	for k: String in b:
		if k != "room_avoidance":
			signals.append("%s %.2f" % [k, b[k]])
	out.append_array(["", "Behaviour at the end: %s. Room avoidance: %s." % [", ".join(signals), str(b["room_avoidance"])]])
	out.append_array(["", "Errors: %s. Warnings: %s. Entity in the player's room: %s." % [_list(r["errors"]), _list(r["warnings"]), _list(r["violations"])]])
	return out


func _list(a: Array) -> String:
	return "none" if a.is_empty() else "; ".join(a)


func _mmss(t: float) -> String:
	return "%d:%04.1f" % [int(t) / 60, fmod(t, 60.0)]
